{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Project Concern Tree",
  "type": "object",
  "required": [
    "schema_version",
    "project_id",
    "generated_from",
    "aspects",
    "updated_at"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "project_id": {
      "type": "string"
    },
    "generated_from": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "aspects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "dimensions"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "dimensions": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "name",
                "slots"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "slots": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "id",
                      "name",
                      "status",
                      "evidence_refs",
                      "decision_refs",
                      "requirement_refs"
                    ],
                    "properties": {
                      "id": {
                        "type": "string"
                      },
                      "name": {
                        "type": "string"
                      },
                      "status": {
                        "enum": [
                          "untouched",
                          "partial",
                          "covered",
                          "not_applicable",
                          "deferred"
                        ]
                      },
                      "evidence_refs": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      "decision_refs": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      "requirement_refs": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      "rationale": {
                        "type": "string"
                      }
                    },
                    "additionalProperties": false
                  }
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false
}