{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Discovery Domain Ontology Seed",
  "type": "object",
  "required": [
    "schema_version",
    "domain",
    "aspects"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "domain": {
      "type": "string"
    },
    "aspects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "dimensions"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "dimensions": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "name",
                "slots"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "slots": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "id",
                      "name"
                    ],
                    "properties": {
                      "id": {
                        "type": "string"
                      },
                      "name": {
                        "type": "string"
                      }
                    },
                    "additionalProperties": false
                  }
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}