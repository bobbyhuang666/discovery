{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Discovery Living Specification",
  "type": "object",
  "required": [
    "schema_version",
    "project_id",
    "constitution_ref",
    "updated_at",
    "principles",
    "actors",
    "requirements",
    "decisions",
    "invariants",
    "known_unknowns",
    "applied_changes"
  ],
  "properties": {
    "schema_version": {
      "const": "2.0"
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "principles": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/namedItem"
      }
    },
    "actors": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/namedItem"
      }
    },
    "requirements": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/requirement"
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/decision"
      }
    },
    "invariants": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/namedItem"
      }
    },
    "known_unknowns": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/unknown"
      }
    },
    "applied_changes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "constitution_ref": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "$defs": {
    "namedItem": {
      "type": "object",
      "required": [
        "id",
        "statement",
        "status"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "statement": {
          "type": "string"
        },
        "status": {
          "enum": [
            "active",
            "deferred",
            "out_of_scope",
            "superseded"
          ]
        },
        "provenance_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    },
    "requirement": {
      "type": "object",
      "required": [
        "id",
        "title",
        "statement",
        "priority",
        "status",
        "acceptance_criteria"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "statement": {
          "type": "string"
        },
        "priority": {
          "enum": [
            "p0",
            "p1",
            "p2"
          ]
        },
        "status": {
          "enum": [
            "active",
            "deferred",
            "out_of_scope",
            "superseded"
          ]
        },
        "acceptance_criteria": {
          "type": "array"
        },
        "provenance_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "superseded_by": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": true
    },
    "decision": {
      "type": "object",
      "required": [
        "id",
        "statement",
        "status"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "statement": {
          "type": "string"
        },
        "status": {
          "enum": [
            "accepted",
            "deferred",
            "superseded"
          ]
        },
        "rationale": {
          "type": "string"
        },
        "reversal_conditions": {
          "type": "array"
        }
      },
      "additionalProperties": true
    },
    "unknown": {
      "type": "object",
      "required": [
        "id",
        "statement",
        "handling"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "statement": {
          "type": "string"
        },
        "handling": {
          "enum": [
            "default",
            "owner",
            "experiment",
            "revisit"
          ]
        },
        "detail": {
          "type": "string"
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
