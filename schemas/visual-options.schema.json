{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Discovery Visual Options",
  "type": "object",
  "required": ["schema_version", "title", "decision", "options"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "title": {"type": "string"},
    "decision": {"type": "string"},
    "options": {
      "type": "array", "minItems": 2, "maxItems": 4,
      "items": {
        "type": "object",
        "required": ["id", "title", "summary", "tradeoff", "regions"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
          "title": {"type": "string"},
          "summary": {"type": "string"},
          "tradeoff": {"type": "string"},
          "regions": {
            "type": "array", "minItems": 1,
            "items": {
              "type": "object",
              "required": ["label", "span", "height", "emphasis"],
              "properties": {
                "label": {"type": "string"},
                "span": {"type": "integer", "minimum": 1, "maximum": 12},
                "height": {"enum": ["small", "medium", "large"]},
                "emphasis": {"enum": ["low", "medium", "high"]}
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
