{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Discovery Coverage Map",
  "type": "object",
  "required": ["schema_version", "session_id", "updated_at", "concerns", "summary"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "session_id": {"type": "string"},
    "updated_at": {"type": "string", "format": "date-time"},
    "concerns": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "status", "impact", "evidence_refs", "unresolved_decision_ids", "defer_reason"],
        "properties": {
          "id": {"type": "string"},
          "name": {"type": "string"},
          "status": {"enum": ["clear", "partial", "missing", "not_applicable", "deferred"]},
          "impact": {"enum": ["high", "medium", "low"]},
          "evidence_refs": {"type": "array", "items": {"type": "string"}},
          "unresolved_decision_ids": {"type": "array", "items": {"type": "string"}},
          "defer_reason": {"type": ["string", "null"]}
        },
        "additionalProperties": false
      }
    },
    "summary": {
      "type": "object",
      "required": ["clear", "partial", "missing", "not_applicable", "deferred"],
      "properties": {
        "clear": {"type": "integer", "minimum": 0},
        "partial": {"type": "integer", "minimum": 0},
        "missing": {"type": "integer", "minimum": 0},
        "not_applicable": {"type": "integer", "minimum": 0},
        "deferred": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
